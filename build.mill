//| mill-jvm-version: temurin:21
package build

import mill._, scalalib._

private val flixScalaVersion = "2.13.18"

/**
 * One compiler-facing adapter, compiled in isolation against the oldest compiler of its ABI
 * family: `flixJar` names that jar in `plugin/lib`. It is not the pinned `flix.jar`, which moves
 * forward with each verified release: compiling against it would let a reference that only the
 * newer release provides slip into a family whose floor lacks it.
 */
trait FlixAdapter extends ScalaModule {
  def flixJar: String

  def scalaVersion = flixScalaVersion

  def scalacOptions = Seq("-deprecation", "-feature", "-Xfatal-warnings")

  def compilerJar = Task.Source(moduleDir / os.up / os.up / "plugin" / "lib" / flixJar)

  def compileClasspath = Task {
    super.compileClasspath() ++ Seq(plugin.compile().classes, compilerJar())
  }
}

/** Compiler-facing modules, grouped physically and logically under one adapter boundary. */
object adapter extends Module {
  /** The current adapter, against the oldest compiler in its ABI family (0.76.1 through 0.79.0). */
  object flix0761 extends FlixAdapter { def flixJar = "flix-0.76.1.jar" }

  /** The outgoing adapter. */
  object flix0753 extends FlixAdapter { def flixJar = "flix-0.75.3.jar" }

  /** An older adapter. */
  object flix0680 extends FlixAdapter { def flixJar = "flix-0.68.0.jar" }

  /** The pre-0.68 adapter. */
  object flix0672 extends FlixAdapter { def flixJar = "flix-0.67.2.jar" }

  /** The pre-0.67.2 adapter. */
  object flix0661 extends FlixAdapter { def flixJar = "flix-0.66.1.jar" }

  /** The Validation-era adapter. */
  object flix0610 extends FlixAdapter { def flixJar = "flix-0.61.0.jar" }

  /** The pre-extensible-match adapter, against Flix 0.60.0. */
  object flix0600 extends FlixAdapter { def flixJar = "flix-0.60.0.jar" }

  /** Every adapter, newest first. The one list the class paths below are built from. */
  def all: Seq[FlixAdapter] =
    Seq(flix0761, flix0753, flix0680, flix0672, flix0661, flix0610, flix0600)
}

/**
 * Compiler-neutral plugin code. Every Scala adapter is compiled in its own module under
 * `adapter`, so compiler types are unavailable here even at compile time.
 */
object plugin extends ScalaModule {

  /**
   * Used by the test module. Adapter modules independently use the same version because their
   * classes are loaded alongside the compiler's bundled Scala library on one class path.
   */
  def scalaVersion = flixScalaVersion

  def javacOptions = Seq("-Xlint:all", "-Werror", "--release", "21")

  /** Validate the explicit source checkout on every invocation, including cached builds. */
  def sdkSource = Task.Input {
    os.Path(os.proc("sh", moduleDir / os.up / "scripts" / "check-sdk-source.sh")
      .call().out.text().trim)
  }

  /** Embed only the pinned, compiler-neutral kit sources and its license resources. */
  override def sources = Task {
    super.sources() ++ Seq(PathRef(sdkSource() / "kit" / "src"))
  }

  override def resources = Task {
    super.resources() ++ Seq(PathRef(sdkSource() / "kit" / "resources"))
  }

  /**
   * The current compiler jar, exposed only to the current adapter and tests.
   *
   * <p>Never bundled: at run time it is the jar flixw pinned and verified for the project,
   * placed on the class path by the bridge phase. Bundling a copy would mean measuring one
   * compiler while claiming to measure another.
   *
   * <p>`scripts/fetch-flix.sh` puts it in `lib/` and checks its digest. It is deliberately not
   * on this module's compile class path.
   */
  def compilerJars = Task.Sources(moduleDir / "lib")

  def flixJar = Task {
    compilerJars()
      .filter(ref => os.exists(ref.path))
      .flatMap(ref => os.list(ref.path).filter(_.last == "flix.jar").map(PathRef(_)))
  }

  /** Package every adapter family, but none of the compiler jars used to compile them. */
  override def localClasspath = Task {
    super.localClasspath() ++ Task.traverse(adapter.all)(_.compile)().map(_.classes)
  }

  /**
   * Project classes only: the compiler-neutral module plus every adapter module.
   *
   * <p>Not an assembly. scala-library is on the class path at run time because the compiler
   * jar bundles it, so shipping a second copy would put two scala-libraries on one flat class
   * path and let ordering decide which one the engine links against.
   */
  def mainClass = Some("dev.flixw.metrics.Main")

  /**
   * What flixw's help screen says this plugin is for.
   *
   * <p>Declared here because the alternative is flixw running the plugin to ask, and flixw
   * refuses to execute unaudited third-party code to render a help screen. `plugin install`
   * reads this attribute as data -- the zip's central directory, never a class load -- and
   * records it in the project's lock.toml. One line: it lands in a table beside every other
   * command.
   */
  def manifest = Task {
    super.manifest().add(
      "Flixw-Plugin-Description" -> "code metrics, counted by the compiler not by reading text",
      // The bare verb this plugin answers, so `./flixw metrics` works and
      // `./flixw metrics` stays as the always-unambiguous long form. Plural:
      // singular `metric` is a compiler verb in flix-fork, and dispatch is compiler-first,
      // so declaring that word would make this plugin unreachable wherever the fork is
      // pinned -- and would silently change owner the day the fork drops it.
      "Flixw-Plugin-Command" -> "metrics")
  }

  /**
   * Plain `main` methods, run in order, not a framework.
   *
   * A test dependency would be the plugin's first managed dependency, and this module ships a
   * jar onto a class path it shares with a compiler -- the fewer things on it, the fewer ways
   * two copies of something can meet. The assertions are `require`; a failure is a stack trace
   * naming the sentence that did not hold.
   */
  object test extends ScalaTests {
    def testFramework = "none"

    /** Test-only: parse emitted JSON with the Gson already bundled in the pinned compiler jar. */
    override def compileClasspath = Task {
      super.compileClasspath() ++ plugin.flixJar() ++
        Task.traverse(adapter.all)(_.compile)().map(_.classes)
    }

    def check() = Task.Command {
      val cp = (runClasspath() ++ Seq(compile().classes)).map(_.path).mkString(":")
      val sourceRoot = moduleDir / "src"
      val special = Set("dev.flixw.metrics.CompilerCapabilitiesTest",
                        "dev.flixw.metrics.Flix0600AdapterTest",
                        "dev.flixw.metrics.Flix0610AdapterTest",
                        "dev.flixw.metrics.Flix0661AdapterTest",
                        "dev.flixw.metrics.Flix0672AdapterTest",
                        "dev.flixw.metrics.Flix0680AdapterTest",
                        "dev.flixw.metrics.Flix0753AdapterTest",
                        "dev.flixw.metrics.Flix0761AdapterTest",
                        "dev.flixw.metrics.DefinitionSpanTest",
                        "dev.flixw.metrics.PluginIntegrationTest")
      val mains = os.walk(sourceRoot)
        .filter(path => path.ext == "java" && path.last.endsWith("Test.java"))
        .map(path => path.relativeTo(sourceRoot).toString.stripSuffix(".java").replace('/', '.'))
        .filterNot(special)
        .sorted
      for (main <- mains) {
        os.proc("java", "-cp", cp, main).call(stdout = os.Inherit, stderr = os.Inherit)
      }
      val fixture = moduleDir / "fixtures" / "semantic"
      val compiler = plugin.flixJar().head.path
      val outgoingCompiler = moduleDir / os.up / "lib" / "flix-0.76.0.jar"
      val outgoingFamilyCompiler = adapter.flix0753.compilerJar().path
      val olderCompiler = adapter.flix0680.compilerJar().path
      val oldestCompiler = adapter.flix0672.compilerJar().path
      val earliestCompiler = adapter.flix0661.compilerJar().path
      val validationCompiler = adapter.flix0610.compilerJar().path
      val preExtMatchCompiler = adapter.flix0600.compilerJar().path
      val integrationCp = cp + java.io.File.pathSeparator + compiler
      val outgoingIntegrationCp = cp + java.io.File.pathSeparator + outgoingCompiler
      val olderIntegrationCp = cp + java.io.File.pathSeparator + olderCompiler
      val oldestIntegrationCp = cp + java.io.File.pathSeparator + oldestCompiler
      val earliestIntegrationCp = cp + java.io.File.pathSeparator + earliestCompiler
      val validationIntegrationCp = cp + java.io.File.pathSeparator + validationCompiler
      val preExtMatchIntegrationCp = cp + java.io.File.pathSeparator + preExtMatchCompiler
      os.proc("java", "-cp", cp, "dev.flixw.metrics.CompilerCapabilitiesTest", compiler,
              outgoingFamilyCompiler, olderCompiler, oldestCompiler, earliestCompiler,
              validationCompiler, preExtMatchCompiler)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      val validationFixture = moduleDir / "fixtures" / "semantic-validation"
      os.proc("java", "-cp", preExtMatchIntegrationCp, "dev.flixw.metrics.Flix0600AdapterTest",
              validationFixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", validationIntegrationCp, "dev.flixw.metrics.Flix0610AdapterTest",
              validationFixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", earliestIntegrationCp, "dev.flixw.metrics.Flix0661AdapterTest", fixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", oldestIntegrationCp, "dev.flixw.metrics.Flix0672AdapterTest", fixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", olderIntegrationCp, "dev.flixw.metrics.Flix0680AdapterTest", fixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", outgoingIntegrationCp, "dev.flixw.metrics.Flix0753AdapterTest", fixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", integrationCp, "dev.flixw.metrics.Flix0761AdapterTest", fixture)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", integrationCp, "dev.flixw.metrics.DefinitionSpanTest")
        .call(stdout = os.Inherit, stderr = os.Inherit)
      os.proc("java", "-cp", integrationCp, "dev.flixw.metrics.PluginIntegrationTest", fixture,
              plugin.jar().path, compiler)
        .call(stdout = os.Inherit, stderr = os.Inherit)
      ()
    }
  }
}
