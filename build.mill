package build

import mill._, scalalib._

private val flixScalaVersion = "2.13.18"

/** The current adapter, compiled in isolation against the oldest compiler in its ABI family. */
object flix0753 extends ScalaModule {
  def scalaVersion = flixScalaVersion

  def scalacOptions = Seq("-deprecation", "-feature", "-Xfatal-warnings")

  def compilerJar = Task.Source(moduleDir / os.up / "plugin" / "lib" / "flix.jar")

  def compileClasspath = Task {
    super.compileClasspath() ++ Seq(plugin.compile().classes, compilerJar())
  }
}

/** An older adapter compiled in isolation against the oldest compiler in its ABI family. */
object flix0680 extends ScalaModule {
  def scalaVersion = flixScalaVersion

  def scalacOptions = Seq("-deprecation", "-feature", "-Xfatal-warnings")

  def compilerJar = Task.Source(moduleDir / os.up / "plugin" / "lib" / "flix-0.68.0.jar")

  def compileClasspath = Task {
    super.compileClasspath() ++ Seq(plugin.compile().classes, compilerJar())
  }
}

/** The pre-0.68 adapter, compiled in isolation against its oldest compiler family member. */
